{
  "name": "Technocore DID Starter",
  "build": { "dockerfile": "Dockerfile" },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.pylance",
        "ms-python.black-formatter",
        "charliermarsh.ruff",
        "humao.rest-client",
        "eamodio.gitlens",
        "github.vscode-github-actions",
        "redhat.vscode-yaml",
        "ms-vscode.makefile-tools"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter",
          "editor.formatOnSave": true
        },
        "ruff.enable": true
      }
    }
  },

  "postCreateCommand": "pip install -r requirements.txt && echo '\\n✅ Technocore DID Starter ready! Run: python technocore_agent.py --help\\n'",

  "forwardPorts": [7432],
  "portsAttributes": {
    "7432": {
      "label": "Technocore Web Dashboard",
      "onAutoForward": "openBrowser"
    }
  }
}
