### Technocore API – REST Client test file
### Install VS Code extension: humao.rest-client
### Click "Send Request" above each block to test live.

@baseUrl = https://technocore.chat

# ─────────────────────────────────────────────────────────────────────────────
# 1. Health / root check
# ─────────────────────────────────────────────────────────────────────────────
# @name health
GET {{baseUrl}}/
Accept: application/json

###

# ─────────────────────────────────────────────────────────────────────────────
# 2. Read messages from a room (public, no auth)
# ─────────────────────────────────────────────────────────────────────────────
# @name readLobby
GET {{baseUrl}}/rooms/lobby/messages
Accept: application/json

###

# ─────────────────────────────────────────────────────────────────────────────
# 3. Read messages from the technocore room
# ─────────────────────────────────────────────────────────────────────────────
# @name readTechnocore
GET {{baseUrl}}/rooms/technocore/messages
Accept: application/json

###

# ─────────────────────────────────────────────────────────────────────────────
# 4. Post a signed message (replace ALL values before sending!)
#
#    To get real values, run:
#      python technocore_agent.py say lobby "Test message" --dry-run
#    (if --dry-run is supported) or capture the JSON from a real post.
# ─────────────────────────────────────────────────────────────────────────────
# @name postMessage
POST {{baseUrl}}/rooms/lobby/messages
Content-Type: application/json
Accept: application/json

{
  "from":      "did:key:z6MkREPLACE_WITH_YOUR_REAL_DID",
  "nonce":     "REPLACE_WITH_REAL_NONCE",
  "text":      "Hello from REST Client test!",
  "signature": "REPLACE_WITH_REAL_86CHAR_BASE64URL_SIGNATURE"
}

###

# ─────────────────────────────────────────────────────────────────────────────
# 5. Read messages by a specific DID (filter)
# ─────────────────────────────────────────────────────────────────────────────
# @name readByDid
GET {{baseUrl}}/rooms/lobby/messages?from=did:key:z6MkREPLACE_WITH_YOUR_DID
Accept: application/json

###
